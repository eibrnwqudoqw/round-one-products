# Set these in Netlify Project configuration > Environment variables, Functions scope.
# Do not send keys in chat or place them in dist/, products.json, or Git.
# Redeploy after changing function environment settings.
SITE_URL=https://your-site.netlify.app
PAYMENTS_ENABLED=false

# Required explicit shipping choices. Blank keeps checkout disabled.
# Integer AUD cents, e.g. enter your actual flat charge; 0 explicitly means free shipping.
SHIPPING_CENTS=
# Comma-separated destinations you actually service. Example: AU
SHIPPING_COUNTRIES=

# Stripe: use credentials that own the existing Price IDs in products.json.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal REST app credentials. No browser SDK or public key is required here.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
