# Set these in Netlify > Project configuration > Environment variables.
# All scopes works; select Functions if your plan supports specific scopes.
# This file is documentation: Netlify does NOT automatically import it.
# Never commit actual secrets. Redeploy after changing settings.
SITE_URL=https://roundoneboxing.netlify.app
PAYMENTS_ENABLED=false

# New safeguards: missing provider switches default to false; mode defaults to test.
PAYMENT_MODE=test
STRIPE_ENABLED=false
PAYPAL_ENABLED=false

# Owner-confirmed delivery policy: free shipping within Australia only.
SHIPPING_CENTS=0
SHIPPING_COUNTRIES=AU

# TEST mode: use a test key and test webhook, then fill config/stripe-test-prices.json.
# LIVE mode: use a live key/webhook; original products.json Price IDs are preserved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Match credentials and webhook to this PayPal app environment.
# PAYMENT_MODE=test requires sandbox; PAYMENT_MODE=live requires live.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Paid-order-only false-positive correction. Add these in Netlify, not source code.
# Keep all working payment settings unchanged.
NETLIFY_FORMS_TOKEN=
# Netlify project ID (UUID), not project name or website URL. SITE_ID is a fallback.
NETLIFY_FORMS_SITE_ID=
